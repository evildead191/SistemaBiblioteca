@model SistemaBiblioteca.Business.DTOs.MaterialBibliografico.MaterialBibliograficoEditDto

<form asp-action="EditarModal"
      asp-controller="MaterialBibliografico"
      method="post"
      id="formEditarMaterial">

    @Html.AntiForgeryToken()

    <input asp-for="IdMaterialBibliografico"
           type="hidden" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="NumeroFicha"
                   class="form-label">
                Número de ficha
            </label>

            <input asp-for="NumeroFicha"
                   class="form-control" />

            <span asp-validation-for="NumeroFicha"
                  class="text-danger">
            </span>
        </div>

        <div class="col-md-6">
            <label asp-for="Clasificacion"
                   class="form-label">
                Clasificación
            </label>

            <input asp-for="Clasificacion"
                   class="form-control" />

            <span asp-validation-for="Clasificacion"
                  class="text-danger">
            </span>
        </div>

        <div class="col-12">
            <label asp-for="Titulo"
                   class="form-label">
                Título
            </label>

            <input asp-for="Titulo"
                   class="form-control" />

            <span asp-validation-for="Titulo"
                  class="text-danger">
            </span>
        </div>

        <div class="col-md-8">
            <label asp-for="Autor"
                   class="form-label">
                Autor
            </label>

            <input asp-for="Autor"
                   class="form-control" />

            <span asp-validation-for="Autor"
                  class="text-danger">
            </span>
        </div>

        <div class="col-md-4">
            <label asp-for="AnioPublicacion"
                   class="form-label">
                Año de publicación
            </label>

            <input asp-for="AnioPublicacion"
                   class="form-control"
                   type="number" />

            <span asp-validation-for="AnioPublicacion"
                  class="text-danger">
            </span>
        </div>

        <div class="col-12">
            <div class="form-check">
                <input asp-for="Activo"
                       class="form-check-input" />

                <label asp-for="Activo"
                       class="form-check-label">
                    Material activo
                </label>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <button type="button"
                class="btn btn-outline-secondary"
                data-bs-dismiss="modal">
            Cancelar
        </button>

        <button type="submit"
                class="btn btn-primary">
            Guardar cambios
        </button>
    </div>
</form>