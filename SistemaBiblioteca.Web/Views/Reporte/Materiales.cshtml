@model SistemaBiblioteca.Web.ViewModels.Reporte.ReporteMaterialViewModel

@{
    ViewData["Title"] = "Reporte de Materiales";
}

<div class="container py-4">

    <div class="d-flex flex-column flex-md-row
        justify-content-between align-items-md-center
        gap-3 mb-4">

        <div>
            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-book me-2"></i>
                Reporte de Materiales
            </h2>

            <p class="text-muted mb-0">
                Consulte la información registrada en el catálogo bibliográfico.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Volver
        </a>

    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <form method="get"
                  asp-action="Materiales">

                <div class="row g-3">

                    <div class="col-md-8">
                        <label asp-for="Filtro.Busqueda"
                               class="form-label">
                            Buscar
                        </label>

                        <input asp-for="Filtro.Busqueda"
                               class="form-control"
                               placeholder="Título, autor, ficha o clasificación..." />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Filtro.Activo"
                               class="form-label">
                            Estado del registro
                        </label>

                        <select asp-for="Filtro.Activo"
                                asp-items="Model.EstadosRegistro"
                                class="form-select">
                        </select>
                    </div>

                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">

                    <button type="submit"
                            class="btn btn-primary">
                        <i class="bi bi-search me-1"></i>
                        Buscar
                    </button>

                    <a asp-action="Materiales"
                       class="btn btn-outline-secondary">
                        <i class="bi bi-eraser me-1"></i>
                        Limpiar
                    </a>

                    <a asp-action="ExportarMateriales"
                       asp-route-Busqueda="@Model.Filtro.Busqueda"
                       asp-route-Activo="@Model.Filtro.Activo"
                       class="btn btn-success ms-md-auto">
                        <i class="bi bi-file-earmark-excel me-1"></i>
                        Exportar Excel
                    </a>

                </div>

            </form>

        </div>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-6 col-lg-3">
            <div class="dashboard-card h-100">
                <h3>@Model.TotalResultados</h3>
                <span>Materiales encontrados</span>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="dashboard-card h-100">
                <h3>@Model.TotalEjemplares</h3>
                <span>Ejemplares</span>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="dashboard-card h-100">
                <h3>@Model.EjemplaresDisponibles</h3>
                <span>Disponibles</span>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="dashboard-card h-100">
                <h3>@Model.EjemplaresPrestados</h3>
                <span>Prestados</span>
            </div>
        </div>

    </div>

    <div class="card shadow-sm border-0">

        @if (Model.Materiales.Count == 0)
        {
            <div class="card-body text-center py-5">
                <i class="bi bi-search display-4 text-muted"></i>

                <h5 class="mt-3 mb-2">
                    No se encontraron materiales
                </h5>

                <p class="text-muted mb-0">
                    Ajuste los filtros e intente nuevamente.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Ficha</th>
                            <th>Título</th>
                            <th>Autor</th>
                            <th>Clasificación</th>
                            <th class="text-center">Ejemplares</th>
                            <th class="text-center">Disponibles</th>
                            <th class="text-center">Prestados</th>
                            <th class="text-center">Estado</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var material in Model.Materiales)
                        {
                            <tr>
                                <td>
                                    <strong>@material.NumeroFicha</strong>
                                </td>

                                <td>@material.Titulo</td>

                                <td>@material.Autor</td>

                                <td>@material.Clasificacion</td>

                                <td class="text-center">
                                    @material.TotalEjemplares
                                </td>

                                <td class="text-center">
                                    @material.EjemplaresDisponibles
                                </td>

                                <td class="text-center">
                                    @material.EjemplaresPrestados
                                </td>

                                <td class="text-center">
                                    @if (material.Activo)
                                    {
                                        <span class="badge bg-success">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactivo
                                        </span>
                                    }
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>