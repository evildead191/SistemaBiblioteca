@model SistemaBiblioteca.Web.ViewModels.Reporte.ReporteIndexViewModel

@{
    ViewData["Title"] = "Reportes";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-bar-chart-line-fill me-2"></i>
                Centro de Reportes
            </h2>

            <p class="text-muted mb-0">
                Consulte y exporte la información registrada en el sistema.
            </p>

        </div>

    </div>

    <div class="row g-4 mb-5">

        <div class="col-lg-2 col-md-4">

            <div class="dashboard-card">

                <div class="dashboard-icon bg-primary">
                    <i class="bi bi-book"></i>
                </div>

                <h3>@Model.TotalMateriales</h3>

                <span>Materiales</span>

            </div>

        </div>

        <div class="col-lg-2 col-md-4">

            <div class="dashboard-card">

                <div class="dashboard-icon bg-success">
                    <i class="bi bi-journals"></i>
                </div>

                <h3>@Model.TotalEjemplares</h3>

                <span>Ejemplares</span>

            </div>

        </div>

        <div class="col-lg-2 col-md-4">

            <div class="dashboard-card">

                <div class="dashboard-icon bg-info">
                    <i class="bi bi-people"></i>
                </div>

                <h3>@Model.TotalUsuarios</h3>

                <span>Usuarios</span>

            </div>

        </div>

        <div class="col-lg-2 col-md-4">

            <div class="dashboard-card">

                <div class="dashboard-icon bg-warning">
                    <i class="bi bi-arrow-left-right"></i>
                </div>

                <h3>@Model.TotalPrestamos</h3>

                <span>Préstamos</span>

            </div>

        </div>

        <div class="col-lg-2 col-md-4">

            <div class="dashboard-card">

                <div class="dashboard-icon bg-secondary">
                    <i class="bi bi-clock-history"></i>
                </div>

                <h3>@Model.PrestamosActivos</h3>

                <span>Activos</span>

            </div>

        </div>

        <div class="col-lg-2 col-md-4">

            <div class="dashboard-card">

                <div class="dashboard-icon bg-danger">
                    <i class="bi bi-exclamation-circle"></i>
                </div>

                <h3>@Model.PrestamosAtrasados</h3>

                <span>Atrasados</span>

            </div>

        </div>

    </div>

    <div class="row g-4">

        <div class="col-lg-3">

            <a asp-action="Materiales"
               class="text-decoration-none">

                <div class="card h-100 shadow-sm border-0 reporte-card">

                    <div class="card-body text-center">

                        <i class="bi bi-book display-5 text-primary"></i>

                        <h5 class="mt-3">
                            Materiales
                        </h5>

                        <p class="text-muted mb-0">
                            Consulta completa del catálogo.
                        </p>

                    </div>

                </div>

            </a>

        </div>

        <div class="col-lg-3">

            <a asp-action="Ejemplares"
               class="text-decoration-none">

                <div class="card h-100 shadow-sm border-0 reporte-card">

                    <div class="card-body text-center">

                        <i class="bi bi-journals display-5 text-success"></i>

                        <h5 class="mt-3">
                            Ejemplares
                        </h5>

                        <p class="text-muted mb-0">
                            Estado y disponibilidad.
                        </p>

                    </div>

                </div>

            </a>

        </div>

        <div class="col-lg-3">

            <a asp-action="Usuarios"
               class="text-decoration-none">

                <div class="card h-100 shadow-sm border-0 reporte-card">

                    <div class="card-body text-center">

                        <i class="bi bi-people display-5 text-info"></i>

                        <h5 class="mt-3">
                            Usuarios
                        </h5>

                        <p class="text-muted mb-0">
                            Personas registradas.
                        </p>

                    </div>

                </div>

            </a>

        </div>

        <div class="col-lg-3">

            <a asp-action="Prestamos"
               class="text-decoration-none">

                <div class="card h-100 shadow-sm border-0 reporte-card">

                    <div class="card-body text-center">

                        <i class="bi bi-arrow-left-right display-5 text-warning"></i>

                        <h5 class="mt-3">
                            Préstamos
                        </h5>

                        <p class="text-muted mb-0">
                            Historial y préstamos activos.
                        </p>

                    </div>

                </div>

            </a>

        </div>

    </div>

</div>