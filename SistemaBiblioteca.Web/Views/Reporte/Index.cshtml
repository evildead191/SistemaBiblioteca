@model SistemaBiblioteca.Web.ViewModels.Reporte.ReporteIndexViewModel

@{
    ViewData["Title"] = "Reportes";
}

<div class="container py-4 reporte-page">

    <div class="reporte-header mb-4">

        <div>
            <span class="reporte-section-label">
                Gestión de información
            </span>

            <h1 class="reporte-title">
                <i class="bi bi-bar-chart-line-fill me-2"></i>
                Centro de Reportes
            </h1>

            <p class="text-muted mb-0">
                Consulte y exporte la información registrada en el sistema.
            </p>
        </div>

    </div>

    <section class="mb-5">

        <div class="reporte-section-heading mb-3">
            <div>
                <h2>Resumen general</h2>

                <p class="text-muted mb-0">
                    Estado actual de los principales registros del sistema.
                </p>
            </div>
        </div>

        <div class="row g-3">

            <div class="col-6 col-md-4 col-xl-2">
                <div class="reporte-stat-card reporte-stat-blue">

                    <div class="reporte-stat-top">
                        <div class="reporte-stat-icon">
                            <i class="bi bi-book"></i>
                        </div>
                    </div>

                    <div class="reporte-stat-value">
                        @Model.TotalMateriales
                    </div>

                    <div class="reporte-stat-title">
                        Materiales
                    </div>

                    <div class="reporte-stat-description">
                        Registros del catálogo.
                    </div>

                </div>
            </div>

            <div class="col-6 col-md-4 col-xl-2">
                <div class="reporte-stat-card reporte-stat-green">

                    <div class="reporte-stat-top">
                        <div class="reporte-stat-icon">
                            <i class="bi bi-journals"></i>
                        </div>
                    </div>

                    <div class="reporte-stat-value">
                        @Model.TotalEjemplares
                    </div>

                    <div class="reporte-stat-title">
                        Ejemplares
                    </div>

                    <div class="reporte-stat-description">
                        Copias registradas.
                    </div>

                </div>
            </div>

            <div class="col-6 col-md-4 col-xl-2">
                <div class="reporte-stat-card reporte-stat-mint">

                    <div class="reporte-stat-top">
                        <div class="reporte-stat-icon">
                            <i class="bi bi-people"></i>
                        </div>
                    </div>

                    <div class="reporte-stat-value">
                        @Model.TotalUsuarios
                    </div>

                    <div class="reporte-stat-title">
                        Usuarios
                    </div>

                    <div class="reporte-stat-description">
                        Personas registradas.
                    </div>

                </div>
            </div>

            <div class="col-6 col-md-4 col-xl-2">
                <div class="reporte-stat-card reporte-stat-gold">

                    <div class="reporte-stat-top">
                        <div class="reporte-stat-icon">
                            <i class="bi bi-arrow-left-right"></i>
                        </div>
                    </div>

                    <div class="reporte-stat-value">
                        @Model.TotalPrestamos
                    </div>

                    <div class="reporte-stat-title">
                        Préstamos
                    </div>

                    <div class="reporte-stat-description">
                        Historial total.
                    </div>

                </div>
            </div>

            <div class="col-6 col-md-4 col-xl-2">
                <div class="reporte-stat-card reporte-stat-purple">

                    <div class="reporte-stat-top">
                        <div class="reporte-stat-icon">
                            <i class="bi bi-clock-history"></i>
                        </div>
                    </div>

                    <div class="reporte-stat-value">
                        @Model.PrestamosActivos
                    </div>

                    <div class="reporte-stat-title">
                        Activos
                    </div>

                    <div class="reporte-stat-description">
                        Pendientes de devolución.
                    </div>

                </div>
            </div>

            <div class="col-6 col-md-4 col-xl-2">
                <div class="reporte-stat-card reporte-stat-red">

                    <div class="reporte-stat-top">
                        <div class="reporte-stat-icon">
                            <i class="bi bi-exclamation-triangle"></i>
                        </div>
                    </div>

                    <div class="reporte-stat-value">
                        @Model.PrestamosAtrasados
                    </div>

                    <div class="reporte-stat-title">
                        Atrasados
                    </div>

                    <div class="reporte-stat-description">
                        Requieren seguimiento.
                    </div>

                </div>
            </div>

        </div>

    </section>

    <section>

        <div class="reporte-section-heading mb-3">
            <div>
                <h2>Reportes disponibles</h2>

                <p class="text-muted mb-0">
                    Seleccione el tipo de información que desea consultar.
                </p>
            </div>
        </div>

        <div class="row g-4">

            <div class="col-md-6 col-xl-3">
                <a asp-action="Materiales"
                   class="reporte-access-card">

                    <div class="reporte-access-icon access-blue">
                        <i class="bi bi-book"></i>
                    </div>

                    <div class="reporte-access-content">
                        <h3>Materiales</h3>

                        <p>
                            Consulte el catálogo, la clasificación y la
                            cantidad de ejemplares asociados.
                        </p>

                        <span>
                            Ver reporte
                            <i class="bi bi-arrow-right ms-1"></i>
                        </span>
                    </div>

                </a>
            </div>

            <div class="col-md-6 col-xl-3">
                <a asp-action="Ejemplares"
                   class="reporte-access-card">

                    <div class="reporte-access-icon access-green">
                        <i class="bi bi-journals"></i>
                    </div>

                    <div class="reporte-access-content">
                        <h3>Ejemplares</h3>

                        <p>
                            Revise disponibilidad, estado físico y biblioteca
                            asignada.
                        </p>

                        <span>
                            Ver reporte
                            <i class="bi bi-arrow-right ms-1"></i>
                        </span>
                    </div>

                </a>
            </div>

            <div class="col-md-6 col-xl-3">
                <a asp-action="Usuarios"
                   class="reporte-access-card">

                    <div class="reporte-access-icon access-mint">
                        <i class="bi bi-people"></i>
                    </div>

                    <div class="reporte-access-content">
                        <h3>Usuarios</h3>

                        <p>
                            Consulte personas registradas y su historial de
                            préstamos.
                        </p>

                        <span>
                            Ver reporte
                            <i class="bi bi-arrow-right ms-1"></i>
                        </span>
                    </div>

                </a>
            </div>

            <div class="col-md-6 col-xl-3">
                <a asp-action="Prestamos"
                   class="reporte-access-card">

                    <div class="reporte-access-icon access-gold">
                        <i class="bi bi-arrow-left-right"></i>
                    </div>

                    <div class="reporte-access-content">
                        <h3>Préstamos</h3>

                        <p>
                            Consulte préstamos activos, devueltos y atrasados.
                        </p>

                        <span>
                            Ver reporte
                            <i class="bi bi-arrow-right ms-1"></i>
                        </span>
                    </div>

                </a>
            </div>

        </div>

    </section>

</div>