@model SistemaBiblioteca.Web.ViewModels.Reporte.ReporteEjemplarViewModel

@{
    ViewData["Title"] = "Reporte de Ejemplares";
}

<div class="container py-4">

    <div class="d-flex flex-column flex-md-row
        justify-content-between align-items-md-center
        gap-3 mb-4">

        <div>
            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-journals me-2"></i>
                Reporte de Ejemplares
            </h2>

            <p class="text-muted mb-0">
                Consulte los ejemplares según su estado y disponibilidad.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Volver
        </a>

    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <form method="get"
                  asp-action="Ejemplares">

                <div class="row g-3">

                    <div class="col-lg-6">
                        <label asp-for="Filtro.Busqueda"
                               class="form-label">
                            Buscar
                        </label>

                        <input asp-for="Filtro.Busqueda"
                               class="form-control"
                               placeholder="Código, inscripción, título, autor o biblioteca..." />
                    </div>

                    <div class="col-md-6 col-lg-3">
                        <label asp-for="Filtro.Estado"
                               class="form-label">
                            Estado del ejemplar
                        </label>

                        <select asp-for="Filtro.Estado"
                                asp-items="Model.EstadosEjemplar"
                                class="form-select">
                        </select>
                    </div>

                    <div class="col-md-6 col-lg-3">
                        <label asp-for="Filtro.Activo"
                               class="form-label">
                            Estado del registro
                        </label>

                        <select asp-for="Filtro.Activo"
                                asp-items="Model.EstadosRegistro"
                                class="form-select">
                        </select>
                    </div>

                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">

                    <button type="submit"
                            class="btn btn-primary">
                        <i class="bi bi-search me-1"></i>
                        Buscar
                    </button>

                    <a asp-action="Ejemplares"
                       class="btn btn-outline-secondary">
                        <i class="bi bi-eraser me-1"></i>
                        Limpiar
                    </a>

                    <a asp-action="ExportarEjemplares"
                       asp-route-Busqueda="@Model.Filtro.Busqueda"
                       asp-route-Estado="@Model.Filtro.Estado"
                       asp-route-Activo="@Model.Filtro.Activo"
                       class="btn btn-success ms-md-auto">
                        <i class="bi bi-file-earmark-excel me-1"></i>
                        Exportar Excel
                    </a>

                </div>

            </form>

        </div>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-6 col-lg">
            <div class="dashboard-card h-100">
                <h3>@Model.TotalResultados</h3>
                <span>Resultados</span>
            </div>
        </div>

        <div class="col-6 col-lg">
            <div class="dashboard-card h-100">
                <h3>@Model.TotalDisponibles</h3>
                <span>Disponibles</span>
            </div>
        </div>

        <div class="col-6 col-lg">
            <div class="dashboard-card h-100">
                <h3>@Model.TotalPrestados</h3>
                <span>Prestados</span>
            </div>
        </div>

        <div class="col-6 col-lg">
            <div class="dashboard-card h-100">
                <h3>@Model.TotalMantenimiento</h3>
                <span>Mantenimiento</span>
            </div>
        </div>

        <div class="col-12 col-lg">
            <div class="dashboard-card h-100">
                <h3>@Model.TotalFueraServicio</h3>
                <span>Fuera de servicio</span>
            </div>
        </div>

    </div>

    <div class="card shadow-sm border-0">

        @if (Model.Ejemplares.Count == 0)
        {
            <div class="card-body text-center py-5">
                <i class="bi bi-search display-4 text-muted"></i>

                <h5 class="mt-3 mb-2">
                    No se encontraron ejemplares
                </h5>

                <p class="text-muted mb-0">
                    Ajuste los filtros e intente nuevamente.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Código</th>
                            <th>Inscripción</th>
                            <th>Material</th>
                            <th>Autor</th>
                            <th>Biblioteca</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center">Registro</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var ejemplar in Model.Ejemplares)
                        {
                            <tr>
                                <td>
                                    <strong>@ejemplar.CodigoBarras</strong>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(
                                        ejemplar.NumeroInscripcion)
                                        ? "No indicada"
                                        : ejemplar.NumeroInscripcion)
                                </td>

                                <td>
                                    <div class="fw-semibold">
                                        @ejemplar.TituloMaterial
                                    </div>

                                    <small class="text-muted">
                                        Ficha: @ejemplar.NumeroFicha
                                    </small>
                                </td>

                                <td>@ejemplar.AutorMaterial</td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(
                                        ejemplar.Biblioteca)
                                        ? "No indicada"
                                        : ejemplar.Biblioteca)
                                </td>

                                <td class="text-center">

                                    @switch (ejemplar.Estado)
                                    {
                                        case SistemaBiblioteca.Entities.Enums
                                            .EstadoEjemplar.Disponible:

                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle me-1"></i>
                                                Disponible
                                            </span>
                                            break;

                                        case SistemaBiblioteca.Entities.Enums
                                            .EstadoEjemplar.Prestado:

                                            <span class="badge bg-primary">
                                                <i class="bi bi-arrow-left-right me-1"></i>
                                                Prestado
                                            </span>
                                            break;

                                        case SistemaBiblioteca.Entities.Enums
                                            .EstadoEjemplar.Mantenimiento:

                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-tools me-1"></i>
                                                Mantenimiento
                                            </span>
                                            break;

                                        case SistemaBiblioteca.Entities.Enums
                                            .EstadoEjemplar.FueraDeServicio:

                                            <span class="badge bg-danger">
                                                <i class="bi bi-x-circle me-1"></i>
                                                Fuera de servicio
                                            </span>
                                            break;
                                    }

                                </td>

                                <td class="text-center">
                                    @if (ejemplar.Activo)
                                    {
                                        <span class="badge bg-success">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactivo
                                        </span>
                                    }
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>