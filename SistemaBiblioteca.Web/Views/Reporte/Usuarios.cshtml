@model SistemaBiblioteca.Web.ViewModels.Reporte.ReporteUsuarioViewModel

@{
    ViewData["Title"] = "Reporte de Usuarios";
}

<div class="container py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>

            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-people me-2"></i>
                Reporte de Usuarios
            </h2>

            <p class="text-muted mb-0">
                Consulte los usuarios registrados en el sistema.
            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Volver

        </a>

    </div>

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <form method="get">

                <div class="row g-3">

                    <div class="col-lg-6">

                        <label class="form-label">
                            Buscar
                        </label>

                        <input asp-for="Filtro.Busqueda"
                               class="form-control"
                               placeholder="Nombre, identificación, correo..." />

                    </div>

                    <div class="col-md-3">

                        <label class="form-label">
                            Tipo
                        </label>

                        <select asp-for="Filtro.TipoUsuario"
                                asp-items="Model.TiposUsuario"
                                class="form-select">
                        </select>

                    </div>

                    <div class="col-md-3">

                        <label class="form-label">
                            Estado
                        </label>

                        <select asp-for="Filtro.Activo"
                                asp-items="Model.EstadosRegistro"
                                class="form-select">
                        </select>

                    </div>

                </div>

                <div class="d-flex gap-2 mt-4">

                    <button class="btn btn-primary">

                        <i class="bi bi-search me-1"></i>

                        Buscar

                    </button>

                    <a asp-action="Usuarios"
                       class="btn btn-outline-secondary">

                        Limpiar

                    </a>

                    <button class="btn btn-success ms-auto"
                            disabled>

                        <i class="bi bi-file-earmark-excel me-1"></i>

                        Exportar Excel

                    </button>

                </div>

            </form>

        </div>

    </div>

    <div class="row mb-4">

        <div class="col">

            <div class="dashboard-card">

                <h3>@Model.TotalResultados</h3>

                <span>Usuarios</span>

            </div>

        </div>

        <div class="col">

            <div class="dashboard-card">

                <h3>@Model.UsuariosActivos</h3>

                <span>Activos</span>

            </div>

        </div>

        <div class="col">

            <div class="dashboard-card">

                <h3>@Model.UsuariosInactivos</h3>

                <span>Inactivos</span>

            </div>

        </div>

        <div class="col">

            <div class="dashboard-card">

                <h3>@Model.TotalPrestamos</h3>

                <span>Préstamos</span>

            </div>

        </div>

    </div>

    <div class="card shadow-sm border-0">

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-light">

                    <tr>

                        <th>Identificación</th>

                        <th>Nombre</th>

                        <th>Tipo</th>

                        <th>Correo</th>

                        <th>Teléfono</th>

                        <th>Préstamos</th>

                        <th>Estado</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var usuario in Model.Usuarios)
                    {
                        <tr>

                            <td>@usuario.Identificacion</td>

                            <td>@usuario.NombreCompleto</td>

                            <td>@usuario.TipoUsuario</td>

                            <td>@usuario.Correo</td>

                            <td>@usuario.Telefono</td>

                            <td>

                                <span class="badge bg-primary">

                                    @usuario.TotalPrestamos

                                </span>

                            </td>

                            <td>

                                @if (usuario.Activo)
                                {
                                    <span class="badge bg-success">
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Inactivo
                                    </span>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>