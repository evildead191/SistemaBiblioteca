@model SistemaBiblioteca.Web.ViewModels.Prestamo.PrestamoCreateViewModel

<form asp-controller="Prestamo"
      asp-action="Crear"
      method="post">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger">
    </div>

    <div class="alert alert-info d-flex align-items-start gap-2">
        <i class="bi bi-info-circle-fill mt-1"></i>

        <div>
            Seleccione el usuario y el ejemplar que desea prestar.
            Al completar el registro, el ejemplar cambiará automáticamente
            al estado <strong>Prestado</strong>.
        </div>
    </div>

    <div class="row g-3">

        <div class="col-12">
            <label asp-for="Prestamo.IdUsuarioBiblioteca"
                   class="form-label">
                Usuario
            </label>

            <select asp-for="Prestamo.IdUsuarioBiblioteca"
                    asp-items="Model.Usuarios"
                    class="form-select">
            </select>

            <span asp-validation-for="Prestamo.IdUsuarioBiblioteca"
                  class="text-danger">
            </span>
        </div>

        <div class="col-12">
            <label asp-for="Prestamo.IdEjemplar"
                   class="form-label">
                Ejemplar disponible
            </label>

            <select asp-for="Prestamo.IdEjemplar"
                    asp-items="Model.EjemplaresDisponibles"
                    class="form-select">
            </select>

            <span asp-validation-for="Prestamo.IdEjemplar"
                  class="text-danger">
            </span>
        </div>

        <div class="col-12 col-md-6">
            <label asp-for="Prestamo.FechaPrestamo"
                   class="form-label">
                Fecha del préstamo
            </label>

            <input asp-for="Prestamo.FechaPrestamo"
                   type="date"
                   class="form-control" />

            <span asp-validation-for="Prestamo.FechaPrestamo"
                  class="text-danger">
            </span>
        </div>

        <div class="col-12 col-md-6">
            <label asp-for="Prestamo.FechaLimiteDevolucion"
                   class="form-label">
                Fecha límite de devolución
            </label>

            <input asp-for="Prestamo.FechaLimiteDevolucion"
                   type="date"
                   class="form-control" />

            <span asp-validation-for="Prestamo.FechaLimiteDevolucion"
                  class="text-danger">
            </span>
        </div>

        <div class="col-12">
            <label asp-for="Prestamo.Observaciones"
                   class="form-label">
                Observaciones
            </label>

            <textarea asp-for="Prestamo.Observaciones"
                      class="form-control"
                      rows="3"
                      placeholder="Información adicional sobre el préstamo"></textarea>

            <span asp-validation-for="Prestamo.Observaciones"
                  class="text-danger">
            </span>
        </div>

    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <button type="button"
                class="btn btn-outline-secondary"
                data-bs-dismiss="modal">
            Cancelar
        </button>

        <button type="submit"
                class="btn btn-primary">
            <i class="bi bi-check-circle me-1"></i>
            Registrar préstamo
        </button>
    </div>
</form>