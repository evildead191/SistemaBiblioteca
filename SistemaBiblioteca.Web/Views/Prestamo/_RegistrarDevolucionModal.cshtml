@model SistemaBiblioteca.Web.ViewModels.Prestamo.PrestamoDevolucionViewModel

<form asp-controller="Prestamo"
      asp-action="RegistrarDevolucion"
      method="post">

    @Html.AntiForgeryToken()

    <input asp-for="Prestamo.IdPrestamo"
           type="hidden" />

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger">
    </div>

    <div class="alert @(Model.EstaAtrasado ? "alert-danger" : "alert-info")">

        @if (Model.EstaAtrasado)
        {
            <div class="fw-semibold">
                <i class="bi bi-exclamation-triangle me-1"></i>
                Este préstamo presenta atraso.
            </div>

            <div class="mt-1">
                Actualmente tiene
                <strong>
                    @Model.DiasAtraso
                    @(Model.DiasAtraso == 1
                        ? "día de atraso"
                        : "días de atraso")
                </strong>.
            </div>
        }
        else
        {
            <div>
                <i class="bi bi-info-circle me-1"></i>
                El préstamo se encuentra dentro del plazo establecido.
            </div>
        }

    </div>

    <div class="card bg-light border-0 mb-4">
        <div class="card-body">

            <div class="row g-3">

                <div class="col-12 col-md-6">
                    <small class="text-muted d-block">
                        Usuario
                    </small>

                    <span class="fw-semibold">
                        @Model.NombreUsuario
                    </span>

                    <div>
                        <small class="text-muted">
                            @Model.IdentificacionUsuario
                        </small>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <small class="text-muted d-block">
                        Material
                    </small>

                    <span class="fw-semibold">
                        @Model.TituloMaterial
                    </span>

                    <div>
                        <small class="text-muted">
                            Ejemplar: @Model.CodigoEjemplar
                        </small>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <small class="text-muted d-block">
                        Fecha del préstamo
                    </small>

                    <span>
                        @Model.FechaPrestamo.ToString("dd/MM/yyyy")
                    </span>
                </div>

                <div class="col-12 col-md-6">
                    <small class="text-muted d-block">
                        Fecha límite
                    </small>

                    <span>
                        @Model.FechaLimiteDevolucion.ToString("dd/MM/yyyy")
                    </span>
                </div>

            </div>
        </div>
    </div>

    <div class="row g-3">

        <div class="col-12 col-md-6">
            <label asp-for="Prestamo.FechaDevolucionReal"
                   class="form-label">
                Fecha de devolución
            </label>

            <input asp-for="Prestamo.FechaDevolucionReal"
                   type="date"
                   class="form-control" />

            <span asp-validation-for="Prestamo.FechaDevolucionReal"
                  class="text-danger">
            </span>
        </div>

        <div class="col-12">
            <label asp-for="Prestamo.Observaciones"
                   class="form-label">
                Observaciones de la devolución
            </label>

            <textarea asp-for="Prestamo.Observaciones"
                      class="form-control"
                      rows="3"
                      placeholder="Estado del ejemplar, observaciones o información adicional"></textarea>

            <span asp-validation-for="Prestamo.Observaciones"
                  class="text-danger">
            </span>
        </div>

    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <button type="button"
                class="btn btn-outline-secondary"
                data-bs-dismiss="modal">
            Cancelar
        </button>

        <button type="submit"
                class="btn btn-success">
            <i class="bi bi-arrow-return-left me-1"></i>
            Confirmar devolución
        </button>
    </div>
</form>