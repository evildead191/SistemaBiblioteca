@model SistemaBiblioteca.Web.ViewModels.Home.DashboardViewModel

@{
    ViewData["Title"] = "Inicio";
}

<div class="dashboard-page">

    <section class="dashboard-hero">
        <div class="container">

            <div class="dashboard-hero-content">

                <div class="dashboard-hero-text">

                    <span class="dashboard-eyebrow">
                        <i class="bi bi-book-half me-1"></i>
                        Gestión bibliotecaria institucional
                    </span>

                    <h1>
                        Bienvenido al
                        <span>Sistema Bibliotecario</span>
                    </h1>

                    <p>
                        Administre el catálogo, los ejemplares y la circulación
                        de materiales de la Escuela Reverendo Francisco Schmitz.
                    </p>

                    <div class="dashboard-hero-actions">

                        <a asp-controller="MaterialBibliografico"
                           asp-action="Index"
                           class="btn btn-light dashboard-hero-button">

                            <i class="bi bi-book me-2"></i>
                            Consultar catálogo
                        </a>

                        <a asp-controller="Ejemplar"
                           asp-action="Index"
                           class="btn btn-outline-light dashboard-hero-button">

                            <i class="bi bi-journals me-2"></i>
                            Administrar ejemplares
                        </a>

                    </div>

                </div>

                <div class="dashboard-hero-logo-wrapper">

                    <div class="dashboard-logo-glow"></div>

                    <img src="~/images/logo-sistema-bibliotecario.png"
                         alt="Logo del Sistema Bibliotecario"
                         class="dashboard-hero-logo" />

                </div>

            </div>

        </div>
    </section>

    <div class="container dashboard-container">

        <section class="dashboard-section">

            <div class="dashboard-section-heading">

                <div>
                    <span class="dashboard-section-label">
                        Resumen general
                    </span>

                    <h2>Indicadores del sistema</h2>

                    <p>
                        Información actualizada con los registros almacenados
                        en la base de datos.
                    </p>
                </div>

                <span class="dashboard-live-badge">
                    <span class="dashboard-live-dot"></span>
                    Datos en tiempo real
                </span>

            </div>

            <div class="row g-4">

                <div class="col-12 col-sm-6 col-xl-3">

                    <a asp-controller="MaterialBibliografico"
                       asp-action="Index"
                       class="dashboard-stat-card dashboard-stat-green">

                        <div class="dashboard-stat-top">

                            <div class="dashboard-stat-icon">
                                <i class="bi bi-book"></i>
                            </div>

                            <i class="bi bi-arrow-up-right dashboard-stat-arrow"></i>

                        </div>

                        <div class="dashboard-stat-value">
                            @Model.TotalMateriales
                        </div>

                        <div class="dashboard-stat-title">
                            Materiales bibliográficos
                        </div>

                        <div class="dashboard-stat-description">
                            Títulos registrados en el catálogo
                        </div>

                    </a>

                </div>

                <div class="col-12 col-sm-6 col-xl-3">

                    <a asp-controller="Ejemplar"
                       asp-action="Index"
                       class="dashboard-stat-card dashboard-stat-blue">

                        <div class="dashboard-stat-top">

                            <div class="dashboard-stat-icon">
                                <i class="bi bi-journals"></i>
                            </div>

                            <i class="bi bi-arrow-up-right dashboard-stat-arrow"></i>

                        </div>

                        <div class="dashboard-stat-value">
                            @Model.TotalEjemplares
                        </div>

                        <div class="dashboard-stat-title">
                            Ejemplares registrados
                        </div>

                        <div class="dashboard-stat-description">
                            Copias físicas administradas
                        </div>

                    </a>

                </div>

                <div class="col-12 col-sm-6 col-xl-3">

                    <a asp-controller="Ejemplar"
                       asp-action="Index"
                       asp-route-busqueda=""
                       class="dashboard-stat-card dashboard-stat-mint">

                        <div class="dashboard-stat-top">

                            <div class="dashboard-stat-icon">
                                <i class="bi bi-check-circle"></i>
                            </div>

                            <i class="bi bi-arrow-up-right dashboard-stat-arrow"></i>

                        </div>

                        <div class="dashboard-stat-value">
                            @Model.EjemplaresDisponibles
                        </div>

                        <div class="dashboard-stat-title">
                            Ejemplares disponibles
                        </div>

                        <div class="dashboard-stat-description">
                            Recursos habilitados para préstamo
                        </div>

                    </a>

                </div>

                <div class="col-12 col-sm-6 col-xl-3">

                    <div class="dashboard-stat-card dashboard-stat-purple">

                        <div class="dashboard-stat-top">

                            <div class="dashboard-stat-icon">
                                <i class="bi bi-arrow-left-right"></i>
                            </div>

                            <span class="dashboard-stat-status">
                                Actual
                            </span>

                        </div>

                        <div class="dashboard-stat-value">
                            @Model.EjemplaresPrestados
                        </div>

                        <div class="dashboard-stat-title">
                            Ejemplares prestados
                        </div>

                        <div class="dashboard-stat-description">
                            Recursos actualmente fuera de biblioteca
                        </div>

                    </div>

                </div>

            </div>

        </section>

        <section class="dashboard-section">

            <div class="dashboard-section-heading">

                <div>
                    <span class="dashboard-section-label">
                        Accesos directos
                    </span>

                    <h2>Acciones rápidas</h2>

                    <p>
                        Ingrese directamente a las principales funciones
                        del sistema.
                    </p>
                </div>

            </div>

            <div class="row g-4">

                <div class="col-12 col-md-6 col-xl-3">

                    <a asp-controller="MaterialBibliografico"
                       asp-action="Index"
                       class="dashboard-action-card">

                        <div class="dashboard-action-icon action-green">
                            <i class="bi bi-book"></i>
                        </div>

                        <div class="dashboard-action-content">

                            <h3>Catálogo bibliográfico</h3>

                            <p>
                                Consulte, registre y edite los materiales
                                disponibles en la biblioteca.
                            </p>

                            <span>
                                Abrir módulo
                                <i class="bi bi-arrow-right ms-1"></i>
                            </span>

                        </div>

                    </a>

                </div>

                <div class="col-12 col-md-6 col-xl-3">

                    <a asp-controller="Ejemplar"
                       asp-action="Index"
                       class="dashboard-action-card">

                        <div class="dashboard-action-icon action-blue">
                            <i class="bi bi-journals"></i>
                        </div>

                        <div class="dashboard-action-content">

                            <h3>Ejemplares</h3>

                            <p>
                                Gestione códigos de barras, disponibilidad
                                y ubicación de cada copia.
                            </p>

                            <span>
                                Abrir módulo
                                <i class="bi bi-arrow-right ms-1"></i>
                            </span>

                        </div>

                    </a>

                </div>

                <div class="col-12 col-md-6 col-xl-3">

                    <div class="dashboard-action-card dashboard-action-disabled">

                        <div class="dashboard-action-icon action-gold">
                            <i class="bi bi-person-check"></i>
                        </div>

                        <div class="dashboard-action-content">

                            <div class="dashboard-action-badge">
                                Próximamente
                            </div>

                            <h3>Registrar préstamo</h3>

                            <p>
                                Controle la entrega de materiales y las fechas
                                previstas para su devolución.
                            </p>

                            <span>
                                Módulo pendiente
                            </span>

                        </div>

                    </div>

                </div>

                <div class="col-12 col-md-6 col-xl-3">

                    <div class="dashboard-action-card dashboard-action-disabled">

                        <div class="dashboard-action-icon action-purple">
                            <i class="bi bi-arrow-return-left"></i>
                        </div>

                        <div class="dashboard-action-content">

                            <div class="dashboard-action-badge">
                                Próximamente
                            </div>

                            <h3>Registrar devolución</h3>

                            <p>
                                Actualice el estado de los ejemplares devueltos
                                a la institución.
                            </p>

                            <span>
                                Módulo pendiente
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </section>

        <section class="dashboard-section">

            <div class="row g-4">

                <div class="col-12 col-xl-8">

                    <div class="dashboard-panel">

                        <div class="dashboard-panel-header">

                            <div>
                                <span class="dashboard-section-label">
                                    Estado del desarrollo
                                </span>

                                <h2>Módulos del sistema</h2>
                            </div>

                            <i class="bi bi-grid dashboard-panel-header-icon"></i>

                        </div>

                        <div class="dashboard-module-list">

                            <div class="dashboard-module-item">

                                <div class="dashboard-module-icon module-complete">
                                    <i class="bi bi-check-lg"></i>
                                </div>

                                <div class="dashboard-module-info">

                                    <div>
                                        <h3>Catálogo bibliográfico</h3>

                                        <p>
                                            Registro, búsqueda, edición y control
                                            del material bibliográfico.
                                        </p>
                                    </div>

                                    <span class="dashboard-module-badge badge-complete">
                                        Implementado
                                    </span>

                                </div>

                            </div>

                            <div class="dashboard-module-item">

                                <div class="dashboard-module-icon module-complete">
                                    <i class="bi bi-check-lg"></i>
                                </div>

                                <div class="dashboard-module-info">

                                    <div>
                                        <h3>Gestión de ejemplares</h3>

                                        <p>
                                            Administración de copias físicas,
                                            códigos y estados de circulación.
                                        </p>
                                    </div>

                                    <span class="dashboard-module-badge badge-complete">
                                        Implementado
                                    </span>

                                </div>

                            </div>

                            <div class="dashboard-module-item">

                                <div class="dashboard-module-icon module-progress">
                                    <i class="bi bi-hourglass-split"></i>
                                </div>

                                <div class="dashboard-module-info">

                                    <div>
                                        <h3>Préstamos y devoluciones</h3>

                                        <p>
                                            Control de salidas, fechas de entrega
                                            y devolución de ejemplares.
                                        </p>
                                    </div>

                                    <span class="dashboard-module-badge badge-progress">
                                        Pendiente
                                    </span>

                                </div>

                            </div>

                            <div class="dashboard-module-item">

                                <div class="dashboard-module-icon module-pending">
                                    <i class="bi bi-circle"></i>
                                </div>

                                <div class="dashboard-module-info">

                                    <div>
                                        <h3>Personas y reportes</h3>

                                        <p>
                                            Registro de usuarios, historial y
                                            generación de reportes administrativos.
                                        </p>
                                    </div>

                                    <span class="dashboard-module-badge badge-pending">
                                        Futuro
                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="col-12 col-xl-4">

                    <div class="dashboard-panel dashboard-future-panel">

                        <div class="dashboard-panel-header">

                            <div>
                                <span class="dashboard-section-label">
                                    Preparado para crecer
                                </span>

                                <h2>Indicadores futuros</h2>
                            </div>

                            <i class="bi bi-bar-chart dashboard-panel-header-icon"></i>

                        </div>

                        <div class="dashboard-future-list">

                            <div class="dashboard-future-item">

                                <span>
                                    <i class="bi bi-arrow-left-right"></i>
                                    Préstamos activos
                                </span>

                                <strong>@Model.PrestamosActivos</strong>

                            </div>

                            <div class="dashboard-future-item">

                                <span>
                                    <i class="bi bi-exclamation-triangle"></i>
                                    Préstamos vencidos
                                </span>

                                <strong>@Model.PrestamosVencidos</strong>

                            </div>

                            <div class="dashboard-future-item">

                                <span>
                                    <i class="bi bi-people"></i>
                                    Personas registradas
                                </span>

                                <strong>@Model.PersonasRegistradas</strong>

                            </div>

                            <div class="dashboard-future-item">

                                <span>
                                    <i class="bi bi-arrow-return-left"></i>
                                    Devoluciones pendientes
                                </span>

                                <strong>@Model.DevolucionesPendientes</strong>

                            </div>

                        </div>

                        <div class="dashboard-future-note">

                            <i class="bi bi-info-circle"></i>

                            <p>
                                Estos indicadores se conectarán automáticamente
                                conforme se implementen los módulos restantes.
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </section>

        <section class="dashboard-institutional">

            <div class="dashboard-institutional-logo">

                <img src="~/images/logo-sistema-bibliotecario.png"
                     alt="Sistema Bibliotecario" />

            </div>

            <div class="dashboard-institutional-content">

                <span class="dashboard-section-label">
                    Escuela Reverendo Francisco Schmitz
                </span>

                <h2>Conocimiento, cultura y organización</h2>

                <p>
                    Este sistema facilita la gestión de los recursos
                    bibliográficos de la institución, permitiendo mantener
                    información organizada, accesible y preparada para apoyar
                    los procesos educativos.
                </p>

            </div>

            <div class="dashboard-institutional-values">

                <span>
                    <i class="bi bi-bank"></i>
                    Cultura
                </span>

                <span>
                    <i class="bi bi-lightbulb"></i>
                    Saber
                </span>

                <span>
                    <i class="bi bi-people"></i>
                    Honor
                </span>

            </div>

        </section>

    </div>

</div>