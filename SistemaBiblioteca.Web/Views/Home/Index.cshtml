@model SistemaBiblioteca.Web.ViewModels.Home.DashboardViewModel

@{
    ViewData["Title"] = "Inicio";
}

<div class="dashboard-page">

    <section class="dashboard-hero">

        <div class="container">

            <div class="dashboard-hero-content">

                <div class="dashboard-hero-text">

                    <span class="dashboard-eyebrow">
                        <i class="bi bi-book-half me-1"></i>
                        Gestión bibliotecaria institucional
                    </span>

                    <h1>
                        Bienvenido al
                        <span>Sistema Bibliotecario</span>
                    </h1>

                    <p>
                        Administre el catálogo, los ejemplares, los usuarios
                        y la circulación de materiales de la
                        Escuela Reverendo Francisco Schmitz.
                    </p>

                    <div class="dashboard-hero-actions">

                        <a asp-controller="Prestamo"
                           asp-action="Index"
                           class="btn btn-light dashboard-hero-button">

                            <i class="bi bi-arrow-left-right me-2"></i>
                            Gestionar préstamos
                        </a>

                        <a asp-controller="Reporte"
                           asp-action="Index"
                           class="btn btn-outline-light dashboard-hero-button">

                            <i class="bi bi-bar-chart-line me-2"></i>
                            Consultar reportes
                        </a>

                    </div>

                </div>

                <div class="dashboard-hero-logo-wrapper">

                    <div class="dashboard-logo-glow"></div>

                    <img src="~/images/logo-sistema-bibliotecario.png"
                         alt="Logo del Sistema Bibliotecario"
                         class="dashboard-hero-logo" />

                </div>

            </div>

        </div>

    </section>

    <div class="container dashboard-container">

        <section class="dashboard-section">

            <div class="dashboard-section-heading">

                <div>

                    <span class="dashboard-section-label">
                        Resumen general
                    </span>

                    <h2>Indicadores del sistema</h2>

                    <p>
                        Información actualizada con los registros almacenados
                        en la base de datos.
                    </p>

                </div>

                <span class="dashboard-live-badge">
                    <span class="dashboard-live-dot"></span>
                    Datos en tiempo real
                </span>

            </div>

            <div class="row g-4">

                <div class="col-12 col-sm-6 col-xl-3">

                    <a asp-controller="MaterialBibliografico"
                       asp-action="Index"
                       class="dashboard-stat-card dashboard-stat-green">

                        <div class="dashboard-stat-top">

                            <div class="dashboard-stat-icon">
                                <i class="bi bi-book"></i>
                            </div>

                            <i class="bi bi-arrow-up-right
                                dashboard-stat-arrow">
                            </i>

                        </div>

                        <div class="dashboard-stat-value">
                            @Model.TotalMateriales
                        </div>

                        <div class="dashboard-stat-title">
                            Materiales bibliográficos
                        </div>

                        <div class="dashboard-stat-description">
                            Títulos registrados en el catálogo
                        </div>

                    </a>

                </div>

                <div class="col-12 col-sm-6 col-xl-3">

                    <a asp-controller="Ejemplar"
                       asp-action="Index"
                       class="dashboard-stat-card dashboard-stat-blue">

                        <div class="dashboard-stat-top">

                            <div class="dashboard-stat-icon">
                                <i class="bi bi-journals"></i>
                            </div>

                            <i class="bi bi-arrow-up-right
                                dashboard-stat-arrow">
                            </i>

                        </div>

                        <div class="dashboard-stat-value">
                            @Model.TotalEjemplares
                        </div>

                        <div class="dashboard-stat-title">
                            Ejemplares registrados
                        </div>

                        <div class="dashboard-stat-description">
                            Copias físicas administradas
                        </div>

                    </a>

                </div>

                <div class="col-12 col-sm-6 col-xl-3">

                    <a asp-controller="UsuarioBiblioteca"
                       asp-action="Index"
                       class="dashboard-stat-card dashboard-stat-mint">

                        <div class="dashboard-stat-top">

                            <div class="dashboard-stat-icon">
                                <i class="bi bi-people"></i>
                            </div>

                            <i class="bi bi-arrow-up-right
                                dashboard-stat-arrow">
                            </i>

                        </div>

                        <div class="dashboard-stat-value">
                            @Model.UsuariosRegistrados
                        </div>

                        <div class="dashboard-stat-title">
                            Usuarios registrados
                        </div>

                        <div class="dashboard-stat-description">
                            Personas registradas en el sistema
                        </div>

                    </a>

                </div>

                <div class="col-12 col-sm-6 col-xl-3">

                    <a asp-controller="Prestamo"
                       asp-action="Index"
                       class="dashboard-stat-card dashboard-stat-purple">

                        <div class="dashboard-stat-top">

                            <div class="dashboard-stat-icon">
                                <i class="bi bi-arrow-left-right"></i>
                            </div>

                            <i class="bi bi-arrow-up-right
                                dashboard-stat-arrow">
                            </i>

                        </div>

                        <div class="dashboard-stat-value">
                            @Model.PrestamosActivos
                        </div>

                        <div class="dashboard-stat-title">
                            Préstamos activos
                        </div>

                        <div class="dashboard-stat-description">
                            Ejemplares pendientes de devolución
                        </div>

                    </a>

                </div>

            </div>

        </section>

        <section class="dashboard-section">

            <div class="dashboard-section-heading">

                <div>

                    <span class="dashboard-section-label">
                        Accesos directos
                    </span>

                    <h2>Módulos principales</h2>

                    <p>
                        Acceda rápidamente a las funciones principales
                        del sistema.
                    </p>

                </div>

            </div>

            <div class="row g-4">

                <div class="col-12 col-md-6 col-xl-4">

                    <a asp-controller="MaterialBibliografico"
                       asp-action="Index"
                       class="dashboard-action-card">

                        <div class="dashboard-action-icon action-green">
                            <i class="bi bi-book"></i>
                        </div>

                        <div class="dashboard-action-content">

                            <h3>Catálogo bibliográfico</h3>

                            <p>
                                Registre, consulte y actualice los materiales
                                bibliográficos de la institución.
                            </p>

                            <span>
                                Abrir módulo
                                <i class="bi bi-arrow-right ms-1"></i>
                            </span>

                        </div>

                    </a>

                </div>

                <div class="col-12 col-md-6 col-xl-4">

                    <a asp-controller="Ejemplar"
                       asp-action="Index"
                       class="dashboard-action-card">

                        <div class="dashboard-action-icon action-blue">
                            <i class="bi bi-journals"></i>
                        </div>

                        <div class="dashboard-action-content">

                            <h3>Ejemplares</h3>

                            <p>
                                Gestione copias, códigos, disponibilidad
                                y estados de los ejemplares.
                            </p>

                            <span>
                                Abrir módulo
                                <i class="bi bi-arrow-right ms-1"></i>
                            </span>

                        </div>

                    </a>

                </div>

                <div class="col-12 col-md-6 col-xl-4">

                    <a asp-controller="UsuarioBiblioteca"
                       asp-action="Index"
                       class="dashboard-action-card">

                        <div class="dashboard-action-icon action-gold">
                            <i class="bi bi-people"></i>
                        </div>

                        <div class="dashboard-action-content">

                            <h3>Usuarios</h3>

                            <p>
                                Administre estudiantes, docentes
                                y personal registrado.
                            </p>

                            <span>
                                Abrir módulo
                                <i class="bi bi-arrow-right ms-1"></i>
                            </span>

                        </div>

                    </a>

                </div>

                <div class="col-12 col-md-6 col-xl-4">

                    <a asp-controller="Prestamo"
                       asp-action="Index"
                       class="dashboard-action-card">

                        <div class="dashboard-action-icon action-purple">
                            <i class="bi bi-arrow-left-right"></i>
                        </div>

                        <div class="dashboard-action-content">

                            <h3>Préstamos y devoluciones</h3>

                            <p>
                                Registre préstamos, devoluciones
                                y controle los atrasos.
                            </p>

                            <span>
                                Abrir módulo
                                <i class="bi bi-arrow-right ms-1"></i>
                            </span>

                        </div>

                    </a>

                </div>

                <div class="col-12 col-md-6 col-xl-4">

                    <a asp-controller="Reporte"
                       asp-action="Index"
                       class="dashboard-action-card">

                        <div class="dashboard-action-icon action-green">
                            <i class="bi bi-bar-chart-line"></i>
                        </div>

                        <div class="dashboard-action-content">

                            <h3>Centro de Reportes</h3>

                            <p>
                                Consulte información consolidada
                                y exporte resultados a Excel.
                            </p>

                            <span>
                                Abrir módulo
                                <i class="bi bi-arrow-right ms-1"></i>
                            </span>

                        </div>

                    </a>

                </div>

            </div>

        </section>

        <section class="dashboard-section">

            <div class="row g-4">

                <div class="col-12 col-xl-8">

                    <div class="dashboard-panel">

                        <div class="dashboard-panel-header">

                            <div>

                                <span class="dashboard-section-label">
                                    Estado actual
                                </span>

                                <h2>Módulos del sistema</h2>

                            </div>

                            <i class="bi bi-grid
                                dashboard-panel-header-icon">
                            </i>

                        </div>

                        <div class="dashboard-module-list">

                            <div class="dashboard-module-item">

                                <div class="dashboard-module-icon
                                    module-complete">

                                    <i class="bi bi-check-lg"></i>
                                </div>

                                <div class="dashboard-module-info">

                                    <div>

                                        <h3>
                                            Catálogo bibliográfico
                                        </h3>

                                        <p>
                                            Registro, búsqueda y mantenimiento
                                            de materiales.
                                        </p>

                                    </div>

                                    <span class="dashboard-module-badge
                                        badge-complete">
                                        Implementado
                                    </span>

                                </div>

                            </div>

                            <div class="dashboard-module-item">

                                <div class="dashboard-module-icon
                                    module-complete">

                                    <i class="bi bi-check-lg"></i>
                                </div>

                                <div class="dashboard-module-info">

                                    <div>

                                        <h3>
                                            Gestión de ejemplares
                                        </h3>

                                        <p>
                                            Registro individual y múltiple,
                                            códigos y disponibilidad.
                                        </p>

                                    </div>

                                    <span class="dashboard-module-badge
                                        badge-complete">
                                        Implementado
                                    </span>

                                </div>

                            </div>

                            <div class="dashboard-module-item">

                                <div class="dashboard-module-icon
                                    module-complete">

                                    <i class="bi bi-check-lg"></i>
                                </div>

                                <div class="dashboard-module-info">

                                    <div>

                                        <h3>
                                            Administración de usuarios
                                        </h3>

                                        <p>
                                            Registro, edición y control
                                            de usuarios de la biblioteca.
                                        </p>

                                    </div>

                                    <span class="dashboard-module-badge
                                        badge-complete">
                                        Implementado
                                    </span>

                                </div>

                            </div>

                            <div class="dashboard-module-item">

                                <div class="dashboard-module-icon
                                    module-complete">

                                    <i class="bi bi-check-lg"></i>
                                </div>

                                <div class="dashboard-module-info">

                                    <div>

                                        <h3>
                                            Préstamos y devoluciones
                                        </h3>

                                        <p>
                                            Control de circulación, fechas
                                            y atrasos.
                                        </p>

                                    </div>

                                    <span class="dashboard-module-badge
                                        badge-complete">
                                        Implementado
                                    </span>

                                </div>

                            </div>

                            <div class="dashboard-module-item">

                                <div class="dashboard-module-icon
                                    module-complete">

                                    <i class="bi bi-check-lg"></i>
                                </div>

                                <div class="dashboard-module-info">

                                    <div>

                                        <h3>
                                            Centro de Reportes
                                        </h3>

                                        <p>
                                            Consultas administrativas
                                            y exportación a Excel.
                                        </p>

                                    </div>

                                    <span class="dashboard-module-badge
                                        badge-complete">
                                        Implementado
                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="col-12 col-xl-4">

                    <div class="dashboard-panel">

                        <div class="dashboard-panel-header">

                            <div>

                                <span class="dashboard-section-label">
                                    Circulación actual
                                </span>

                                <h2>Estado de la biblioteca</h2>

                            </div>

                            <i class="bi bi-activity
                                dashboard-panel-header-icon">
                            </i>

                        </div>

                        <div class="dashboard-future-list">

                            <div class="dashboard-future-item">

                                <span>
                                    <i class="bi bi-check-circle"></i>
                                    Ejemplares disponibles
                                </span>

                                <strong>
                                    @Model.EjemplaresDisponibles
                                </strong>

                            </div>

                            <div class="dashboard-future-item">

                                <span>
                                    <i class="bi bi-arrow-left-right"></i>
                                    Ejemplares prestados
                                </span>

                                <strong>
                                    @Model.EjemplaresPrestados
                                </strong>

                            </div>

                            <div class="dashboard-future-item">

                                <span>
                                    <i class="bi bi-exclamation-triangle"></i>
                                    Préstamos atrasados
                                </span>

                                <strong>
                                    @Model.PrestamosAtrasados
                                </strong>

                            </div>

                            <div class="dashboard-future-item">

                                <span>
                                    <i class="bi bi-person-check"></i>
                                    Usuarios activos
                                </span>

                                <strong>
                                    @Model.UsuariosActivos
                                </strong>

                            </div>

                        </div>

                        <div class="dashboard-future-note">

                            <i class="bi bi-info-circle"></i>

                            <p>
                                Los indicadores se actualizan automáticamente
                                conforme se registran préstamos, devoluciones,
                                ejemplares y usuarios.
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </section>

        <section class="dashboard-institutional">

            <div class="dashboard-institutional-logo">

                <img src="~/images/logo-sistema-bibliotecario.png"
                     alt="Sistema Bibliotecario" />

            </div>

            <div class="dashboard-institutional-content">

                <span class="dashboard-section-label">
                    Escuela Reverendo Francisco Schmitz
                </span>

                <h2>
                    Conocimiento, cultura y organización
                </h2>

                <p>
                    El sistema centraliza la gestión de los recursos
                    bibliográficos de la institución y facilita el control
                    de materiales, usuarios, préstamos y reportes.
                </p>

            </div>

            <div class="dashboard-institutional-values">

                <span>
                    <i class="bi bi-bank"></i>
                    Cultura
                </span>

                <span>
                    <i class="bi bi-lightbulb"></i>
                    Saber
                </span>

                <span>
                    <i class="bi bi-people"></i>
                    Comunidad
                </span>

            </div>

        </section>

    </div>

</div>