@using Microsoft.AspNetCore.Identity
@using SistemaBiblioteca.Entities.Models

@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Sistema Bibliotecario
    </title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/SistemaBiblioteca.web.styles.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>

<body>

    @{
        string controladorActual =
            ViewContext.RouteData.Values["controller"]?
                .ToString()
            ?? string.Empty;

        string ObtenerClaseActiva(
            params string[] controladores)
        {
            return controladores.Any(
                controlador =>
                    controlador.Equals(
                        controladorActual,
                        StringComparison.OrdinalIgnoreCase))
                ? "active"
                : string.Empty;
        }

        ApplicationUser? usuarioActual = null;
        string nombreUsuario = string.Empty;

        if (User.Identity?.IsAuthenticated == true)
        {
            usuarioActual =
                await UserManager.GetUserAsync(User);

            if (usuarioActual is not null)
            {
                nombreUsuario =
                    $"{usuarioActual.Nombre} {usuarioActual.PrimerApellido}"
                        .Trim();

                if (string.IsNullOrWhiteSpace(nombreUsuario))
                {
                    nombreUsuario =
                        usuarioActual.Email
                        ?? usuarioActual.UserName
                        ?? "Usuario";
                }
            }
        }
    }

    <header class="main-header">

        <nav class="navbar navbar-expand-lg navbar-dark biblioteca-navbar">
            <div class="container">

                <a class="navbar-brand biblioteca-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <img src="~/images/logo-sistema-bibliotecario.png"
                         alt="Logo del Sistema Bibliotecario"
                         class="biblioteca-logo" />

                    <span class="brand-text">

                        <span class="brand-title">
                            Sistema Bibliotecario
                        </span>

                        <span class="brand-subtitle">
                            Escuela Reverendo Francisco Schmitz
                        </span>

                    </span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal"
                        aria-expanded="false"
                        aria-label="Mostrar menú">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="menuPrincipal">

                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">

                        <li class="nav-item">
                            <a class="nav-link biblioteca-nav-link
                                @ObtenerClaseActiva("Home")"
                               asp-controller="Home"
                               asp-action="Index">

                                <i class="bi bi-house-door me-1"></i>
                                Inicio
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link biblioteca-nav-link
                                @ObtenerClaseActiva("MaterialBibliografico")"
                               asp-controller="MaterialBibliografico"
                               asp-action="Index">

                                <i class="bi bi-book me-1"></i>
                                Catálogo
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link biblioteca-nav-link
                                @ObtenerClaseActiva("Ejemplar")"
                               asp-controller="Ejemplar"
                               asp-action="Index">

                                <i class="bi bi-journals me-1"></i>
                                Ejemplares
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link biblioteca-nav-link
                                @ObtenerClaseActiva("UsuarioBiblioteca")"
                               asp-controller="UsuarioBiblioteca"
                               asp-action="Index">

                                <i class="bi bi-people me-1"></i>
                                Usuarios
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link biblioteca-nav-link
                                @ObtenerClaseActiva("Prestamo")"
                               asp-controller="Prestamo"
                               asp-action="Index">

                                <i class="bi bi-arrow-left-right me-1"></i>
                                Préstamos
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link biblioteca-nav-link
                                @ObtenerClaseActiva("Reporte")"
                               asp-controller="Reporte"
                               asp-action="Index">

                                <i class="bi bi-bar-chart-line me-1"></i>
                                Reportes
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link biblioteca-nav-link
                                @ObtenerClaseActiva("Integracion")"
                               asp-controller="Integracion"
                               asp-action="Index">

                                <i class="bi bi-file-earmark-arrow-up me-1"></i>
                                Importación
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown ms-lg-2">

                                <button class="nav-link biblioteca-nav-link dropdown-toggle"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">

                                    <i class="bi bi-person-circle me-1"></i>
                                    @nombreUsuario
                                </button>

                                <ul class="dropdown-menu dropdown-menu-end shadow">

                                    <li>
                                        <div class="px-3 py-2">

                                            <div class="fw-semibold">
                                                @nombreUsuario
                                            </div>

                                            <div class="small text-muted">
                                                @usuarioActual?.Email
                                            </div>

                                            <div class="small text-muted">
                                                Administrador
                                            </div>

                                        </div>
                                    </li>

                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>

                                    <li>
                                        <form asp-controller="Account"
                                              asp-action="Logout"
                                              method="post">

                                            <button type="submit"
                                                    class="dropdown-item">

                                                <i class="bi bi-box-arrow-right me-2"></i>
                                                Cerrar sesión

                                            </button>

                                        </form>
                                    </li>

                                </ul>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>

        <div class="navbar-accent-line"></div>
    </header>

    <main role="main"
          class="main-content">

        @RenderBody()

    </main>

    <footer class="biblioteca-footer">

        <div class="container">

            <div class="footer-content">

                <div class="footer-brand">

                    <img src="~/images/logo-sistema-bibliotecario.png"
                         alt="Logo del Sistema Bibliotecario"
                         class="footer-logo" />

                    <div>

                        <div class="footer-title">
                            Sistema Bibliotecario
                        </div>

                        <div class="footer-school">
                            Escuela Reverendo Francisco Schmitz
                        </div>

                    </div>
                </div>

                <div class="footer-copy">
                    &copy; @DateTime.Now.Year — El Porvenir
                </div>

            </div>
        </div>
    </footer>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <form id="formLogoutInactividad"
              asp-controller="Account"
              asp-action="Logout"
              method="post"
              class="d-none">

            <input type="hidden"
                   name="motivo"
                   value="" />

        </form>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>
</html>